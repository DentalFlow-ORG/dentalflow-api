# =========================
# APP
# =========================
NODE_ENV="development"
PORT="3000"
API_PREFIX="api"

# Allowed CORS origins (comma-separated). Required in production (HTTPS only).
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Frontend base URL — used for transactional email links and OAuth redirects.
# Must match the origin of your frontend. Required in production (must be HTTPS).
FRONTEND_URL=http://localhost:5173

# =========================
# DATABASE
# =========================

# Supabase Connect -> ORM -> Prisma
# Use a pooled connection for the running backend when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Connect -> Direct
# Use for Prisma migrations (bypasses PgBouncer).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# =========================
# AUTH (JWT)
# =========================
# Generate a strong random value: openssl rand -base64 64
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================
# GOOGLE AUTH (LOGIN)
# =========================
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID="replace_with_google_login_oauth_client_id"
GOOGLE_CLIENT_SECRET="replace_with_google_login_oauth_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
FRONTEND_AUTH_SUCCESS_URL="http://localhost:5173/acessar/oauth/sucesso"
FRONTEND_AUTH_COMPLETE_PROFILE_URL="http://localhost:5173/acessar/completar-perfil"

# =========================
# STRIPE
# =========================
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_replace_me"

# Stripe Dashboard -> Developers -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Redirect URLs after Stripe Checkout — must be absolute URLs
# Use {CHECKOUT_SESSION_ID} in success_url if you need to look up the session on return
STRIPE_SUCCESS_URL="http://localhost:5173/app/assinatura/sucesso"
STRIPE_CANCEL_URL="http://localhost:5173/app/assinatura/cancelar"

# Return URL after the owner closes the Stripe Billing Portal
STRIPE_PORTAL_RETURN_URL="http://localhost:5173/app/assinatura"

# =========================
# GOOGLE CALENDAR
# =========================
# Google Cloud Console -> OAuth client
GOOGLE_CALENDAR_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_CALENDAR_CLIENT_SECRET="replace_with_google_oauth_client_secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar-integrations/google/callback"

# 32+ chars. Used to encrypt Google OAuth tokens at rest.
GOOGLE_CALENDAR_TOKEN_SECRET="replace_with_a_strong_calendar_token_secret"


# =========================
# AI ASSISTANT (OpenAI)
# =========================
# Local default is disabled. Enable only when deliberately testing configured AI.
OPENAI_AI_ASSISTANT_ENABLED="false"

# OpenAI Dashboard -> API Keys
# Required when OPENAI_AI_ASSISTANT_ENABLED=true. Endpoints return 503 if missing.
OPENAI_API_KEY="sk-replace_with_openai_api_key"

# Model to use for AI analysis AND clinical dictation GPT classification.
# Default: gpt-4o-mini (fast, cost-effective for structured JSON output)
# Other options: gpt-4.1-mini, gpt-4o
# Note: audio transcription for clinical dictation always uses whisper-1 (hardcoded).
OPENAI_MODEL="gpt-4o-mini"

# Maximum output tokens per AI analysis request. Default: 900.
# Higher values allow longer responses but increase cost and latency.
OPENAI_AI_MAX_OUTPUT_TOKENS="900"

# =========================
# WHATSAPP CLOUD API
# =========================
# Keep local/simulated mode by default. Set both values below to enable real sends.
NOTIFICATION_PROVIDER="local"
WHATSAPP_CLOUD_API_ENABLED="false"
WHATSAPP_CLOUD_API_VERSION="v25.0"
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="replace_with_a_random_local_verify_token"
# Required for real production WhatsApp; verifies x-hub-signature-256.
WHATSAPP_APP_SECRET=""
WHATSAPP_DEFAULT_LANGUAGE="pt_BR"

# =========================
# EMAIL (Resend)
# =========================
# Transactional email provider for password reset and future notifications.
# RESEND_API_KEY and MAIL_FROM are mandatory in production.
# Without a key, only development/test may use stub logging.
#
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address configured in your Resend domain settings.
MAIL_FROM="DentalFlow <no-reply@your-domain.com>"

# =========================
# PRODUCTION REFERENCE (Render)
# =========================
# Copy the values below into your Render environment variables.
# Do NOT commit real secrets to this file.
#
# NODE_ENV=production
# PORT=10000                                      (Render assigns this automatically)
# FRONTEND_ORIGIN=https://dentalflow-web-teal.vercel.app
# FRONTEND_URL=https://dentalflow-web-teal.vercel.app
# DATABASE_URL=<Supabase pooled connection string>
# DIRECT_URL=<Supabase direct connection string>
# JWT_SECRET=<strong random secret — openssl rand -base64 64>
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://dentalflow-web-teal.vercel.app/app/assinatura/sucesso
# STRIPE_CANCEL_URL=https://dentalflow-web-teal.vercel.app/app/assinatura/cancelar
# STRIPE_PORTAL_RETURN_URL=https://dentalflow-web-teal.vercel.app/app/assinatura
# GOOGLE_CALENDAR_CLIENT_ID=<Google Cloud Console OAuth client ID>
# GOOGLE_CALENDAR_CLIENT_SECRET=<Google Cloud Console OAuth client secret>
# GOOGLE_CALENDAR_REDIRECT_URI=https://dentalflow-api.onrender.com/api/calendar-integrations/google/callback
# GOOGLE_CALENDAR_TOKEN_SECRET=<32+ char random secret>
# OPENAI_API_KEY=sk-...
# RESEND_API_KEY=re_...
# MAIL_FROM=DentalFlow <no-reply@your-domain.com>

# Optional campaign settings. Keep disabled until the offer/coupons are approved.
BILLING_LAUNCH_CAMPAIGN_ENABLED="false"
# BILLING_LAUNCH_TOTAL_SPOTS=100
# BILLING_LAUNCH_CLAIMED_SPOTS=0
# BILLING_LAUNCH_PROMOTION_END_DATE=<approved ISO timestamp>
# STRIPE_LAUNCH_COUPON_STARTER_MONTHLY=
# STRIPE_LAUNCH_COUPON_PROFESSIONAL_MONTHLY=
# STRIPE_LAUNCH_COUPON_PREMIUM_MONTHLY=

# Local fiscal simulation only; setting another name does not add a provider.
FISCAL_PROVIDER="LOCAL"
FISCAL_PROVIDER_MODE="LOCAL"

# Legacy alias: WHATSAPP_WEBHOOK_APP_SECRET (prefer WHATSAPP_APP_SECRET).
# Tests use DATABASE_URL_TEST only with a disposable local PostgreSQL (port 5433).
# SEED_USER_PASSWORD is for reviewed development seeds only; never seed production.
# Full variable and frontend/backend setup reference:
# ../dentalflow-web/docs/development/workspace.md
