# =========================
# APP
# =========================
NODE_ENV="development"
PORT="3000"
API_PREFIX="api"

# Frontend URL used for CORS — must be set in production
FRONTEND_ORIGIN="http://localhost:5173"

# =========================
# DATABASE
# =========================

# Supabase Connect -> ORM -> Prisma
# Use a pooled connection for the running backend when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Connect -> Direct
# Use for Prisma migrations (bypasses PgBouncer).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# =========================
# AUTH (JWT)
# =========================
# Generate a strong random value: openssl rand -base64 64
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================
# STRIPE
# =========================
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_replace_me"

# Stripe Dashboard -> Developers -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
