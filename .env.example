# =========================
# APP
# =========================
NODE_ENV="development"
PORT="3000"
API_PREFIX="api"

# =========================
# DATABASE (SUPABASE)
# =========================

# Supabase Connect -> ORM -> Prisma
# Use a pooled connection for the running backend when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Connect -> Direct
# Use for Prisma migrations when available.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# =========================
# AUTH (JWT)
# =========================
# Generate a strong random value. Never reuse this example value.
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================
# STRIPE
# =========================
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_replace_me"

# Stripe Dashboard -> Developers -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# =========================
# SUPABASE (OPTIONAL)
# =========================
# Supabase Project Settings -> API
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="replace_with_anon_or_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="replace_with_service_role_or_secret_key"
SUPABASE_JWT_SECRET="replace_with_supabase_jwt_secret"
