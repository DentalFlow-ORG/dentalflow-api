# =========================
# APP
# =========================
NODE_ENV="development"
PORT="3000"
API_PREFIX="api"

# Frontend URL used for CORS — must be set in production
FRONTEND_ORIGIN="http://localhost:5173"

# =========================
# DATABASE
# =========================

# Supabase Connect -> ORM -> Prisma
# Use a pooled connection for the running backend when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Connect -> Direct
# Use for Prisma migrations (bypasses PgBouncer).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# =========================
# AUTH (JWT)
# =========================
# Generate a strong random value: openssl rand -base64 64
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# =========================
# STRIPE
# =========================
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY="sk_test_replace_me"

# Stripe Dashboard -> Developers -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Redirect URLs after Stripe Checkout — must be absolute URLs
# Use {CHECKOUT_SESSION_ID} in success_url if you need to look up the session on return
STRIPE_SUCCESS_URL="http://localhost:5173/app/assinatura/sucesso"
STRIPE_CANCEL_URL="http://localhost:5173/app/assinatura/cancelar"

# Return URL after the owner closes the Stripe Billing Portal
STRIPE_PORTAL_RETURN_URL="http://localhost:5173/app/assinatura"

# =========================
# GOOGLE CALENDAR
# =========================
# Google Cloud Console -> OAuth client
GOOGLE_CALENDAR_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_CALENDAR_CLIENT_SECRET="replace_with_google_oauth_client_secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar-integrations/google/callback"

# 32+ chars. Used to encrypt Google OAuth tokens at rest.
GOOGLE_CALENDAR_TOKEN_SECRET="replace_with_a_strong_calendar_token_secret"
