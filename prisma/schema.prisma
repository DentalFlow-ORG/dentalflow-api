// ================================================================
// DENTALFLOW — PRISMA SCHEMA
// Version:      1.0.0
// Database:     PostgreSQL
// ORM:          Prisma 7.7
// Architecture: Multi-tenant SaaS (Clinic as tenant root)
// Designed:     2026-04-24
// ================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ================================================================
// ENUMS
// ================================================================

enum UserRole {
  ADMIN
  OWNER
  DENTIST
  ASSISTANT
  PATIENT
}

enum LeadSource {
  PROFILE_PAGE
  MANUAL
  IMPORT
  REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  CONVERTED
  LOST
  ARCHIVED
}

enum LeadActivityAction {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  CONTACTED
  APPOINTMENT_SCHEDULED
  WHATSAPP_SENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum CanceledBy {
  CLINIC
  PATIENT
  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum FinancialTransactionSource {
  MANUAL
  SERVICE_PAYMENT
  FIXED_EXPENSE
  ADJUSTMENT
}

enum FinancialTransactionStatus {
  PENDING
  PAID
  CANCELED
}

enum FixedExpenseRecurrence {
  MONTHLY
  WEEKLY
  YEARLY
}

enum FiscalDocumentType {
  CPF
  CNPJ
}

enum FiscalTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  OUTRO
}

enum FiscalProvider {
  LOCAL
  FOCUS_NFE
  NFE_IO
  PLUGNOTAS
  OTHER
}

enum FiscalProviderMode {
  LOCAL
  SANDBOX
  PRODUCTION
}

enum ServiceInvoiceStatus {
  DRAFT
  READY_TO_ISSUE
  SIMULATED
  PROCESSING
  ISSUED
  FAILED
  CANCELED
}

// ================================================================
// DOMAIN 1 — IDENTITY, AUTH & RBAC
// ================================================================

model Clinic {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  logoUrl      String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String    @default("BR")
  postalCode   String?
  timezone     String    @default("America/Sao_Paulo")
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  profiles     Profile[]
  leads        Lead[]
  availability Availability[]
  availabilityExceptions AvailabilityException[]
  appointments Appointment[]
  subscription Subscription?
  dailyMetrics DailyMetrics[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  fixedExpenses FixedExpense[]
  fiscalProfile ClinicFiscalProfile?
  serviceInvoices ServiceInvoice[]
  googleCalendarIntegration GoogleCalendarIntegration?
  googleCalendarOAuthStates GoogleCalendarOAuthState[]

  @@map("clinics")
}

model User {
  id                         String    @id @default(cuid())
  clinicId                   String?
  email                      String
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String?
  avatarUrl                  String?
  role                       UserRole  @default(DENTIST)
  isEmailVerified            Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?
  passwordResetExpiresAt     DateTime?
  isActive                   Boolean   @default(true)
  tokenVersion               Int       @default(0)
  lastLoginAt                DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  clinic         Clinic?        @relation(fields: [clinicId], references: [id])
  profile        Profile?
  refreshTokens  RefreshToken[]
  leadActivities LeadActivity[]
  assignedLeads  Lead[]         @relation("AssignedLeads")
  patientAppointments Appointment[] @relation("PatientAppointments")
  patientServiceInvoices ServiceInvoice[] @relation("ServiceInvoicePatient")
  createdFinancialTransactions FinancialTransaction[] @relation("FinancialTransactionCreatedBy")
  createdFixedExpenses FixedExpense[] @relation("FixedExpenseCreatedBy")
  createdServiceInvoices ServiceInvoice[] @relation("ServiceInvoiceCreatedBy")
  updatedServiceInvoices ServiceInvoice[] @relation("ServiceInvoiceUpdatedBy")
  issuedServiceInvoices ServiceInvoice[] @relation("ServiceInvoiceIssuedBy")
  fiscalInvoiceEvents FiscalInvoiceEvent[] @relation("FiscalInvoiceEventCreatedBy")
  googleCalendarConnections GoogleCalendarIntegration[] @relation("GoogleCalendarConnectedBy")
  googleCalendarOAuthStates GoogleCalendarOAuthState[]  @relation("GoogleCalendarOAuthStates")

  @@unique([email])
  @@index([clinicId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ================================================================
// DOMAIN 2 — PROFESSIONAL PROFILE
// ================================================================

model Profile {
  id             String    @id @default(cuid())
  clinicId       String
  userId         String?   @unique
  slug           String    @unique
  displayName    String
  bio            String?   @db.Text
  avatarUrl      String?
  crmNumber      String?
  crmState       String?
  phone          String?
  whatsappNumber String?
  publicEmail    String?
  instagramUrl   String?
  facebookUrl    String?
  websiteUrl     String?
  addressLine1   String?
  city           String?
  state          String?
  country        String    @default("BR")
  postalCode     String?
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  isPublished    Boolean   @default(false)
  viewsCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clinic                 Clinic                  @relation(fields: [clinicId], references: [id])
  user                   User?                   @relation(fields: [userId], references: [id])
  profileSpecialties     ProfileSpecialty[]
  services               Service[]
  leads                  Lead[]
  availability           Availability[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  financialTransactions  FinancialTransaction[]

  @@index([clinicId])
  @@index([isPublished])
  @@map("profiles")
}

model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  profileSpecialties ProfileSpecialty[]

  @@map("specialties")
}

model ProfileSpecialty {
  profileId   String
  specialtyId String
  createdAt   DateTime @default(now())

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([profileId, specialtyId])
  @@map("profile_specialties")
}

model Service {
  id               String   @id @default(cuid())
  profileId        String
  clinicId         String
  name             String
  description      String?  @db.Text
  priceFrom        Decimal? @db.Decimal(10, 2)
  priceTo          Decimal? @db.Decimal(10, 2)
  durationMinutes  Int?
  isPriceDisplayed Boolean  @default(true)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  leads        Lead[]
  appointments Appointment[]
  financialTransactions FinancialTransaction[]

  @@index([profileId])
  @@index([clinicId])
  @@map("services")
}

// ================================================================
// DOMAIN 3 — LEAD MANAGEMENT
// ================================================================

model Lead {
  id               String     @id @default(cuid())
  clinicId         String
  profileId        String
  serviceId        String?
  assignedToUserId String?
  name             String
  email            String?
  phone            String?
  whatsappNumber   String?
  message          String?    @db.Text
  source           LeadSource @default(PROFILE_PAGE)
  status           LeadStatus @default(NEW)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  referrerUrl      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  profile      Profile        @relation(fields: [profileId], references: [id])
  service      Service?       @relation(fields: [serviceId], references: [id])
  assignedTo   User?          @relation("AssignedLeads", fields: [assignedToUserId], references: [id])
  activities   LeadActivity[]
  appointments Appointment[]

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([profileId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id        String             @id @default(cuid())
  leadId    String
  userId    String?
  action    LeadActivityAction
  oldStatus LeadStatus?
  newStatus LeadStatus?
  note      String?            @db.Text
  metadata  Json?
  createdAt DateTime           @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_activities")
}

// ================================================================
// DOMAIN 4 — APPOINTMENT SYSTEM
// ================================================================

model Availability {
  id        String   @id @default(cuid())
  profileId String
  clinicId  String
  dayOfWeek Int      // 0 = Sunday … 6 = Saturday
  startTime DateTime @db.Time // wall-clock in clinic's timezone
  endTime   DateTime @db.Time
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([clinicId])
  @@unique([profileId, dayOfWeek, startTime, endTime])
  @@map("availability")
}

model AvailabilityException {
  id            String   @id @default(cuid())
  profileId     String
  clinicId      String
  exceptionDate DateTime @db.Date
  isDayOff      Boolean   @default(true)
  startTime     DateTime? @db.Time
  endTime       DateTime? @db.Time
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, exceptionDate])
  @@index([exceptionDate])
  @@map("availability_exceptions")
}

model Appointment {
  id                 String            @id @default(cuid())
  clinicId           String
  profileId          String
  patientUserId      String?
  leadId             String?
  serviceId          String?
  patientName        String
  patientEmail       String?
  patientPhone       String?
  appointmentDate    DateTime          @db.Date
  startTime          DateTime          @db.Time
  endTime            DateTime          @db.Time
  durationMinutes    Int
  status             AppointmentStatus @default(PENDING)
  notes              String?           @db.Text
  patientNotes       String?           @db.Text
  canceledBy         CanceledBy?
  canceledAt         DateTime?
  cancellationReason String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  googleCalendarEventId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  profile Profile  @relation(fields: [profileId], references: [id])
  patient User?    @relation("PatientAppointments", fields: [patientUserId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  financialTransactions FinancialTransaction[]
  serviceInvoices ServiceInvoice[]

  @@index([clinicId])
  @@index([profileId])
  @@index([patientUserId])
  @@index([appointmentDate])
  @@index([status])
  @@index([leadId])
  @@index([clinicId, appointmentDate])
  @@index([profileId, appointmentDate])
  @@index([clinicId, profileId, appointmentDate])
  @@index([clinicId, status, appointmentDate])
  @@map("appointments")
}

model GoogleCalendarIntegration {
  id                    String    @id @default(cuid())
  clinicId              String    @unique
  connectedByUserId     String
  googleCalendarId      String    @default("primary")
  googleCalendarSummary String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  syncToken             String?
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  disconnectedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clinic          Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  connectedByUser User   @relation("GoogleCalendarConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Restrict)

  @@index([connectedByUserId])
  @@map("google_calendar_integrations")
}

model GoogleCalendarOAuthState {
  id        String   @id
  clinicId  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation("GoogleCalendarOAuthStates", fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([userId])
  @@map("google_calendar_oauth_states")
}

// ================================================================
// DOMAIN 5 — BILLING & SUBSCRIPTIONS
// ================================================================

model Plan {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String?  @db.Text
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?
  priceMonthly          Int      // in cents — e.g. 9900 = R$99,00
  priceYearly           Int      // in cents
  maxProfiles           Int?     // NULL = unlimited
  maxLeadsPerMonth      Int?     // NULL = unlimited
  maxServicesPerProfile Int?     // NULL = unlimited
  hasAppointments       Boolean  @default(false)
  hasAnalytics          Boolean  @default(false)
  hasCustomDomain       Boolean  @default(false)
  hasPrioritySupport    Boolean  @default(false)
  isActive              Boolean  @default(true)
  isPublic              Boolean  @default(true)
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  clinicId             String             @unique
  planId               String
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  billingInterval      BillingInterval?
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])
  items  SubscriptionItem[]

  @@map("subscriptions")
}

model SubscriptionItem {
  id                       String           @id @default(cuid())
  subscriptionId           String
  stripeSubscriptionItemId String           @unique
  stripePriceId            String
  priceNickname            String?
  billingInterval          BillingInterval?
  unitAmount               Int?
  unitAmountDecimal        String?
  currency                 String
  quantity                 Int              @default(1)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([stripePriceId])
  @@map("subscription_items")
}

model StripeEvent {
  id           String    @id // Stripe event ID (evt_xxx) — idempotency PK
  type         String
  processed    Boolean   @default(false)
  processedAt  DateTime?
  errorMessage String?   @db.Text
  rawPayload   Json
  createdAt    DateTime
  receivedAt   DateTime  @default(now())

  @@index([type])
  @@index([processed])
  @@map("stripe_events")
}

// ================================================================
// DOMAIN 6 — CLINIC FINANCE
// ================================================================

model FinancialCategory {
  id        String                   @id @default(cuid())
  clinicId  String
  name      String
  type      FinancialTransactionType
  color     String?
  icon      String?
  isDefault Boolean                  @default(false)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  clinic        Clinic                 @relation(fields: [clinicId], references: [id])
  transactions  FinancialTransaction[]
  fixedExpenses FixedExpense[]

  @@unique([clinicId, type, name])
  @@index([clinicId])
  @@index([clinicId, type])
  @@map("financial_categories")
}

model FinancialTransaction {
  id               String                     @id @default(cuid())
  clinicId         String
  type             FinancialTransactionType
  source           FinancialTransactionSource @default(MANUAL)
  categoryId       String
  fixedExpenseId   String?
  amount           Decimal                    @db.Decimal(10, 2)
  description      String
  transactionDate  DateTime                   @db.Date
  dueDate          DateTime?                  @db.Date
  paidAt           DateTime?
  status           FinancialTransactionStatus @default(PENDING)
  appointmentId    String?
  serviceId        String?
  profileId        String?
  paymentReference String?
  createdByUserId  String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  category      FinancialCategory @relation(fields: [categoryId], references: [id])
  fixedExpense  FixedExpense?     @relation(fields: [fixedExpenseId], references: [id])
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  service       Service?          @relation(fields: [serviceId], references: [id])
  profile       Profile?          @relation(fields: [profileId], references: [id])
  createdByUser User              @relation("FinancialTransactionCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([clinicId, appointmentId, source])
  @@unique([clinicId, fixedExpenseId, dueDate])
  @@index([clinicId])
  @@index([clinicId, transactionDate])
  @@index([clinicId, status])
  @@index([clinicId, type])
  @@index([categoryId])
  @@index([serviceId])
  @@index([profileId])
  @@map("financial_transactions")
}

model FixedExpense {
  id              String                 @id @default(cuid())
  clinicId        String
  categoryId      String
  description     String
  amount          Decimal                @db.Decimal(10, 2)
  recurrence      FixedExpenseRecurrence @default(MONTHLY)
  dueDay          Int
  startDate       DateTime               @db.Date
  endDate         DateTime?              @db.Date
  isActive        Boolean                @default(true)
  createdByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  clinic        Clinic                 @relation(fields: [clinicId], references: [id])
  category      FinancialCategory      @relation(fields: [categoryId], references: [id])
  createdByUser User                   @relation("FixedExpenseCreatedBy", fields: [createdByUserId], references: [id])
  transactions  FinancialTransaction[]

  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([categoryId])
  @@map("fixed_expenses")
}

model ClinicFiscalProfile {
  id                    String             @id @default(cuid())
  clinicId              String             @unique
  legalName             String
  tradeName             String?
  documentType          FiscalDocumentType
  documentNumber        String
  municipalRegistration String?
  stateRegistration     String?
  taxRegime             FiscalTaxRegime
  specialTaxRegime      String?
  serviceCode           String?
  cnae                  String?
  issRate               Decimal?           @db.Decimal(5, 2)
  addressStreet         String
  addressNumber         String
  addressComplement     String?
  addressNeighborhood   String
  addressCity           String
  addressState          String
  addressZipCode        String
  cityIbgeCode          String?
  fiscalProvider        FiscalProvider     @default(LOCAL)
  fiscalProviderMode    FiscalProviderMode @default(LOCAL)
  isConfigured          Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_fiscal_profiles")
}

model ServiceInvoice {
  id                  String               @id @default(cuid())
  clinicId            String
  patientId           String?
  appointmentId       String?
  createdByUserId     String
  updatedByUserId     String?
  issuedByUserId      String?
  externalInvoiceId   String?
  status              ServiceInvoiceStatus @default(DRAFT)
  environment         FiscalProviderMode   @default(LOCAL)
  isLegalDocument     Boolean              @default(false)
  invoiceNumber       String?
  verificationCode    String?
  rpsNumber           String?
  rpsSeries           String?
  customerName        String
  customerDocument    String?
  customerEmail       String?
  customerPhone       String?
  serviceDescription  String               @db.Text
  serviceCode         String?
  amountCents         Int
  deductionsCents     Int?
  issRate             Decimal?             @db.Decimal(5, 2)
  issAmountCents      Int?
  currency            String               @default("BRL")
  competenceDate      DateTime             @db.Date
  simulatedIssueDate  DateTime?
  issueDate           DateTime?
  pdfUrl              String?
  xmlUrl              String?
  providerRawResponse Json?
  errorMessage        String?              @db.Text
  cancellationReason  String?              @db.Text
  canceledAt          DateTime?
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       User?        @relation("ServiceInvoicePatient", fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdByUser User         @relation("ServiceInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?        @relation("ServiceInvoiceUpdatedBy", fields: [updatedByUserId], references: [id])
  issuedByUser  User?        @relation("ServiceInvoiceIssuedBy", fields: [issuedByUserId], references: [id])
  events        FiscalInvoiceEvent[]

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([clinicId, competenceDate])
  @@index([clinicId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
  @@map("service_invoices")
}

model FiscalInvoiceEvent {
  id               String                @id @default(cuid())
  serviceInvoiceId String
  eventType        String
  previousStatus   ServiceInvoiceStatus?
  nextStatus       ServiceInvoiceStatus?
  message          String?
  metadata         Json?
  createdByUserId  String?
  createdAt        DateTime              @default(now())

  serviceInvoice ServiceInvoice @relation(fields: [serviceInvoiceId], references: [id], onDelete: Cascade)
  createdByUser  User?          @relation("FiscalInvoiceEventCreatedBy", fields: [createdByUserId], references: [id])

  @@index([serviceInvoiceId])
  @@index([serviceInvoiceId, createdAt])
  @@map("fiscal_invoice_events")
}

// ================================================================
// DOMAIN 7 — ANALYTICS
// ================================================================

model DailyMetrics {
  id                    String   @id @default(cuid())
  clinicId              String
  date                  DateTime @db.Date
  profileViews          Int      @default(0)
  leadsNew              Int      @default(0)
  leadsContacted        Int      @default(0)
  leadsConverted        Int      @default(0)
  leadsLost             Int      @default(0)
  appointmentsScheduled Int      @default(0)
  appointmentsCompleted Int      @default(0)
  appointmentsCanceled  Int      @default(0)
  appointmentsNoShow    Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, date])
  @@index([clinicId])
  @@index([date])
  @@map("daily_metrics")
}
