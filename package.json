{
  "name": "dentalflow-api-base",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "bun": ">=1.3.9"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "bun run test:db:migrate && jest --config ./test/jest-e2e.json",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:push": "ts-node --project tsconfig.json scripts/push-test-schema.ts",
    "test:db:reset": "bun run test:db:down && bun run test:db:up",
    "test:db:migrate": "ts-node --project tsconfig.json scripts/migrate-test-database.ts",
    "test:migrations": "ts-node --project tsconfig.json scripts/check-migrations.ts",
    "patients:backfill": "ts-node --project tsconfig.json scripts/backfill-patient-identity.ts",
    "test:integration": "bun run test:db:migrate && jest --config ./test/jest-integration.json",
    "postinstall": "prisma generate",
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent; if (ua && !ua.startsWith('bun')) { console.error('\\nError: use Bun as the package manager.\\nRun: bun install\\n'); process.exit(1) }\"",
    "deadcode": "node scripts/check-dead-code.mjs",
    "prisma:validate": "prisma validate",
    "verify": "bun run typecheck && bun run lint:check && bun run test:cov && bun run deadcode && bun run prisma:validate && bun run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "openai": "^6.37.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/jest-unit-setup.ts"
    ],
    "globalSetup": "<rootDir>/../test/jest-global-setup.ts",
    "coverageThreshold": {
      "global": {
        "statements": 92,
        "branches": 83,
        "functions": 84,
        "lines": 92
      }
    },
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json",
      "clover"
    ],
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ]
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "@nestjs/core",
    "@prisma/engines",
    "bcrypt",
    "prisma"
  ],
  "overrides": {
    "body-parser": "2.3.0",
    "multer": "2.3.0",
    "qs": "6.16.0"
  }
}
